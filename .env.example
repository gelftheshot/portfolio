# Required for the portfolio assistant. Keep the real key in .env.local.
OPENAI_API_KEY=

# Optional model override; the app defaults to the balanced model below.
# OPENAI_MODEL=gpt-6.1-sol

# Set before building when using a different production domain.
NEXT_PUBLIC_SITE_URL=https://portfolio-one-rose-74.vercel.app

# Public production chat requires a shared Redis quota. Local `npm run dev`
# needs only OPENAI_API_KEY. See docs/chat-operations.md for limits and proxy trust.
# CHAT_RATE_LIMIT_MODE=shared
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Or use the complete pair injected by the Vercel Upstash integration:
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=
# Choose one complete pair. Any defined UPSTASH setting takes precedence;
# blank, partial, or invalid explicit settings do not fall back to KV aliases.
# KV_REST_API_READ_ONLY_TOKEN, KV_URL, and REDIS_URL are not REST write credentials.
# CHAT_TRUSTED_PROXY=vercel
# CHAT_CLIENT_RATE_LIMIT=20
# CHAT_DAILY_REQUEST_LIMIT=200
# CHAT_RATE_LIMIT_NAMESPACE=portfolio-production

# Private localhost production preview only; never use on a public deployment.
# CHAT_RATE_LIMIT_MODE=memory

# Contact form: use the public identifiers from your EmailJS dashboard.
# NEXT_PUBLIC_SERVICE_ID=
# NEXT_PUBLIC_TEMPLATE_ID=
# NEXT_PUBLIC_PUBLIC_KEY=

# Private admin. Run npm run admin:setup for credentials and local dotenv syntax.
# Never use NEXT_PUBLIC_ for these values.
# ADMIN_PASSWORD_HASH=
# ADMIN_SESSION_SECRET=
# ADMIN_GITHUB_TOKEN=
# ADMIN_GITHUB_REPOSITORY=gelftheshot/portfolio
# ADMIN_GITHUB_BRANCH=main
# Production admin sign-in, AI settings, and inbox also need the shared Redis
# URL/token above. Read docs/admin.md before enabling the public admin.
